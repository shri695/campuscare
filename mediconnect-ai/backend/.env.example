# Required for a production deployment
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@mediconnect.local
ADMIN_PASSWORD=ChangeThisAdminPassword!

# Optional: when set, the backend uses MongoDB Atlas instead of its local SQLite demo store
MONGODB_URI=
MONGODB_DATABASE=mediconnect

# AI chatbot — obtain a key from Google AI Studio and keep it server-side
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional third-party integrations
MAPS_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=MediConnect <onboarding@example.com>

# Development settings
ALLOWED_ORIGIN=http://localhost:5173
SQLITE_PATH=instance/mediconnect.db
PORT=5000
FLASK_DEBUG=false
